{
  "version": 2,
  "builds": [
    {
      "src": "/frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "installCommand": "npm install --prefix frontend", "buildCommand": "npm run build --prefix frontend", "outputDirectory": "frontend/dist" }
    },
    {
      "src": "/backend/backend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/backend/wsgi.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/dist/$1"
    }
  ]
}
